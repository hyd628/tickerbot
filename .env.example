# Get a token from @BotFather on Telegram
BOT_TOKEN=

# How often to poll for price changes, in minutes
POLL_INTERVAL_MINUTES=5

# Path to the SQLite database file
DB_PATH=alertbot.db

# Optional: CoinGecko API base + demo/pro API key (leave blank to use the public free tier)
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Optional: Pyth Network API key, used to prefer Pyth over CoinGecko for
# Solana/Sui assets Pyth has a feed for (currently native SOL and SUI).
# Get a free trial key at https://terminal.pyth.network (sustained/high-volume
# use may require a paid Pyth Pro plan). Leave blank to always use CoinGecko.
PYTH_API_KEY=
