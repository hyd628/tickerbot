# Get a token from @BotFather on Telegram
BOT_TOKEN=

# How often to poll for price changes, in minutes
POLL_INTERVAL_MINUTES=5

# Path to the SQLite database file
DB_PATH=tickerbot.db

# Optional: CoinGecko API base + demo/pro API key (leave blank to use the public free tier)
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Optional: Pyth Network API key, used to prefer Pyth over CoinGecko for a
# small set of assets it has a feed for (see FEED_IDS in tickerbot/pyth.py —
# currently native SOL, JitoSOL, PYTH, native BTC, native ETH; no Sui feed
# on the free trial). Get a free trial key at https://terminal.pyth.network
# (sustained/high-volume use may require a paid Pyth Pro plan). Leave blank
# to always use CoinGecko for these assets.
PYTH_API_KEY=
