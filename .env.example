# Get a token from @BotFather on Telegram
BOT_TOKEN=

# How often to poll for price changes, in minutes
POLL_INTERVAL_MINUTES=5

# Path to the SQLite database file
DB_PATH=alertbot.db

# Optional: CoinGecko API base + demo/pro API key (leave blank to use the public free tier)
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
